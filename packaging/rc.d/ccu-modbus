#!/bin/sh

ADDON=ccu-modbus
BASE=/usr/local/addons/$ADDON
BIN=$BASE/bin/ccu-modbusd
CONF=/usr/local/etc/config/addons/$ADDON/config.json
PID=/var/run/$ADDON.pid

is_running() {
  [ -f "$PID" ] || return 1
  P="$(cat "$PID" 2>/dev/null)"
  [ -n "$P" ] || return 1
  kill -0 "$P" 2>/dev/null
}

cleanup_legacy() {
  # Older test versions started ccu-modbusd through a logger pipe and stored
  # the logger PID. Such an orphan daemon can keep port 18701 occupied.
  killall ccu-modbusd 2>/dev/null || true
  sleep 1
  rm -f "$PID"
}

start_daemon() {
  [ -x "$BIN" ] || return 1
  [ -f "$CONF" ] || return 1

  if is_running; then
    return 0
  fi

  cleanup_legacy

  cd /
  "$BIN" -config "$CONF" >/dev/null 2>&1 &
  echo $! > "$PID"
  sleep 1

  if is_running; then
    return 0
  fi

  rm -f "$PID"
  return 1
}

stop_daemon() {
  if is_running; then
    P="$(cat "$PID" 2>/dev/null)"
    kill "$P" 2>/dev/null || true
    N=0
    while kill -0 "$P" 2>/dev/null && [ $N -lt 5 ]; do
      sleep 1
      N=$((N+1))
    done
  fi

  # Also remove an orphan from pre-test7 installations.
  killall ccu-modbusd 2>/dev/null || true
  rm -f "$PID"
}

case "$1" in
  init)
    ;;
  start|"")
    start_daemon
    ;;
  stop)
    stop_daemon
    ;;
  restart)
    stop_daemon
    sleep 1
    start_daemon
    ;;
  status)
    if is_running; then
      echo "running"
      exit 0
    fi
    echo "stopped"
    exit 1
    ;;
  info)
    VER="$(cat "$BASE/VERSION" 2>/dev/null)"
    echo "Name: CCU-Modbus"
    echo "Version: $VER"
    echo "Info: <div style='text-align:center'>"
    echo "Info: <img src='https://images.seeklogo.com/logo-png/35/1/modbus-logo-png_seeklogo-355093.png' style='max-width:235px;max-height:70px;margin:2px 0 5px 0' alt='Modbus'><br>"
    echo "Info: <b>CCU-Modbus $VER</b><br>"
    echo "Info: Modbus TCP Interface fuer CCU/OpenCCU<br><br>"
    echo "Info: <a href='https://github.com/WolfHenk/CCU-Modbus' target='_blank'>https://github.com/WolfHenk/CCU-Modbus</a>"
    echo "Info: </div>"
    echo "Config-Url: /addons/ccu-modbus/index.cgi"
    echo "Operations: restart uninstall"
    echo "Update: /addons/ccu-modbus/update-check.cgi"
    ;;
  uninstall)
    stop_daemon
    if [ -x "$BASE/bin/update_addon" ]; then
      "$BASE/bin/update_addon" delete ccu-modbus || true
    fi
    rm -rf /usr/local/etc/config/addons/www/$ADDON
    rm -rf /usr/local/etc/config/addons/$ADDON
    rm -f /usr/local/etc/config/rc.d/$ADDON
    rm -rf "$BASE"
    ;;
  *)
    echo "Usage: $ADDON {start|stop|restart|status|info|uninstall}" >&2
    exit 1
    ;;
esac

exit 0
