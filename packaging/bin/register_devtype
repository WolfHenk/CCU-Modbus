#!/bin/sh
set -eu

MODE="${1:-install}"
TARGET=/www/config/devdescr/DEVDB.tcl
JS_TARGET=/www/devdescr.js
WEBUI_TARGET=/www/webui/webui.js
BASE=/usr/local/addons/ccu-modbus/devdescr
OVERLAY=$BASE/DEVDB.tcl
JS_OVERLAY=$BASE/devdescr.js
WEBUI_OVERLAY=$BASE/webui.js

mkdir -p "$BASE"

unmount_one() {
  _target="$1"
  while grep -F " $_target " /proc/mounts >/dev/null 2>&1; do
    umount "$_target" 2>/dev/null || break
  done
}

unmount_ours() {
  unmount_one "$WEBUI_TARGET"
  unmount_one "$JS_TARGET"
  unmount_one "$TARGET"
}

case "$MODE" in
  install)
    # Never change the CCU's read-only file. Build our own derived copy on
    # /usr/local and bind-mount it over the generated DEVDB at runtime.
    unmount_ours
    [ -f "$TARGET" ] || exit 0

    # Preserve the complete OpenCCU-generated DEVDB.tcl, including helper
    # procedures such as DEV_getImagePath. Add only our device description.
    cp -f "$TARGET" "$OVERLAY"
    cat >>"$OVERLAY" <<'TCL'

# CCU-Modbus runtime device description
if {[lsearch -exact $DEV_LIST "ModBus"] < 0} {
    lappend DEV_LIST "ModBus"
}
set DEV_DESCRIPTION(ModBus) "Modbus-Gerät"
set DEV_PATHS(ModBus) [list \
    [list 50 "/addons/ccu-modbus/img/modbus-logo-50.png"] \
    [list 250 "/addons/ccu-modbus/img/modbus-logo-250.png"]]
set DEV_HIGHLIGHT(ModBus) {}
TCL

    # Refuse to mount an incomplete overlay. This protects native WebUI pages
    # which depend on procedures defined by the generated DEVDB.tcl.
    OVERLAY="$OVERLAY" /usr/bin/tclsh <<'TCL'
source $::env(OVERLAY)
if {[llength [info commands DEV_getImagePath]] != 1} { exit 10 }
if {[lsearch -exact $DEV_LIST "ModBus"] < 0} { exit 11 }
if {[DEV_getImagePath "ModBus" 50] ne "/addons/ccu-modbus/img/modbus-logo-50.png"} { exit 12 }
TCL

    mount -o bind "$OVERLAY" "$TARGET"

    # The current OpenCCU WebUI loads the generated /www/devdescr.js directly.
    # DEVDB.tcl alone is therefore not enough for a device picture in the
    # native device list. Overlay a derived JS copy as well, without touching
    # the read-only original.
    if [ -f "$JS_TARGET" ]; then
      cp -f "$JS_TARGET" "$JS_OVERLAY"
      cat >>"$JS_OVERLAY" <<'JS'

// CCU-Modbus runtime device description
if (typeof DEV_LIST !== "undefined" && DEV_LIST.indexOf("ModBus") < 0) DEV_LIST.push("ModBus");
if (typeof DEV_DESCRIPTION !== "undefined") DEV_DESCRIPTION["ModBus"] = "Modbus-Gerät";
if (typeof DEV_PATHS !== "undefined") {
  DEV_PATHS["ModBus"] = new Object();
  DEV_PATHS["ModBus"]["50"] = "/addons/ccu-modbus/img/modbus-logo-50.png";
  DEV_PATHS["ModBus"]["250"] = "/addons/ccu-modbus/img/modbus-logo-250.png";
}
if (typeof DEV_HIGHLIGHT !== "undefined") DEV_HIGHLIGHT["ModBus"] = new Object();
JS
      mount -o bind "$JS_OVERLAY" "$JS_TARGET"
    fi

    # OpenCCU 3.x keeps the device type table inside webui.js. Build a derived
    # copy under the addon and add ModBus before DeviceTypeList is initialized.
    # The original OpenCCU file is never modified.
    if [ -f "$WEBUI_TARGET" ]; then
      TMP_WEBUI="$WEBUI_OVERLAY.tmp.$$"
      awk '
        !inserted && /^DeviceType = Class.create\(/ {
          inserted=1
          print "// CCU-Modbus runtime device type"
          print "if (typeof DEV_LIST !== \"undefined\" && DEV_LIST.indexOf(\"ModBus\") < 0) DEV_LIST.push(\"ModBus\");"
          print "if (typeof DEV_DESCRIPTION !== \"undefined\") DEV_DESCRIPTION[\"ModBus\"] = \"Modbus-Ger\\u00e4t\";"
          print "if (typeof DEV_PATHS !== \"undefined\") {"
          print "  DEV_PATHS[\"ModBus\"] = new Object();"
          print "  DEV_PATHS[\"ModBus\"][\"50\"] = \"/addons/ccu-modbus/img/modbus-logo-50.png\";"
          print "  DEV_PATHS[\"ModBus\"][\"250\"] = \"/addons/ccu-modbus/img/modbus-logo-250.png\";"
          print "}"
          print "if (typeof DEV_HIGHLIGHT !== \"undefined\") DEV_HIGHLIGHT[\"ModBus\"] = new Object();"
        }
        { print }
      ' "$WEBUI_TARGET" > "$TMP_WEBUI"
      [ -s "$TMP_WEBUI" ] || { rm -f "$TMP_WEBUI"; exit 1; }
      grep -F 'DEV_DESCRIPTION["ModBus"] = "Modbus-Ger\u00e4t"' "$TMP_WEBUI" >/dev/null || { rm -f "$TMP_WEBUI"; exit 1; }
      mv -f "$TMP_WEBUI" "$WEBUI_OVERLAY"
      mount -o bind "$WEBUI_OVERLAY" "$WEBUI_TARGET"
    fi
    ;;

  remove)
    # Removing the bind mount instantly exposes the untouched CCU file again.
    unmount_ours
    rm -rf "$BASE"
    ;;

  *)
    echo "Usage: $0 {install|remove}" >&2
    exit 2
    ;;
esac
