#!/bin/sh
# Register/remove the add-on owned ModBus device class in the CCU WebUI device DB.
# This only adds/removes our own key and points the images to the add-on's local logo.
set -eu

MODE="${1:-install}"
DB=/www/config/devdescr/DEVDB.tcl
[ -f "$DB" ] || exit 0

MODE="$MODE" DB="$DB" /usr/bin/tclsh <<'TCL'
set mode $::env(MODE)
set db $::env(DB)

source $db

set type "ModBus"
set thumb "/addons/ccu-modbus/img/modbus-logo.svg"
set image "/addons/ccu-modbus/img/modbus-logo.svg"

if {$mode eq "install"} {
    if {[lsearch -exact $DEV_LIST $type] < 0} {
        lappend DEV_LIST $type
    }
    set DEV_DESCRIPTION($type) "ModBus"
    set DEV_PATHS($type) [list [list 50 $thumb] [list 250 $image]]
    set DEV_HIGHLIGHT($type) {}
} elseif {$mode eq "remove"} {
    set idx [lsearch -exact $DEV_LIST $type]
    if {$idx >= 0} {
        set DEV_LIST [lreplace $DEV_LIST $idx $idx]
    }
    catch {unset DEV_DESCRIPTION($type)}
    catch {unset DEV_PATHS($type)}
    catch {unset DEV_HIGHLIGHT($type)}
} else {
    exit 2
}

set tmp "$db.ccu-modbus.[pid]"
set f [open $tmp w]
puts $f "set DEV_LIST [list $DEV_LIST]"
puts $f "array set DEV_DESCRIPTION [list [array get DEV_DESCRIPTION]]"
puts $f "array set DEV_PATHS [list [array get DEV_PATHS]]"
puts $f "array set DEV_HIGHLIGHT [list [array get DEV_HIGHLIGHT]]"
close $f
file rename -force $tmp $db
TCL
