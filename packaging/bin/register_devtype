#!/bin/sh
set -eu

MODE="${1:-install}"
TARGET=/www/config/devdescr/DEVDB.tcl
JS_TARGET=/www/devdescr.js
DP_TARGET=/www/rega/esp/datapointconfigurator.fn
BASE=/usr/local/addons/ccu-modbus/devdescr
OVERLAY=$BASE/DEVDB.tcl
JS_OVERLAY=$BASE/devdescr.js
DP_OVERLAY=$BASE/datapointconfigurator.fn

mkdir -p "$BASE"

unmount_one() {
  _target="$1"
  # Bind mounts of files are reported in /proc/mounts with the backing device
  # rather than the source filename. Therefore unmount by target path and peel
  # off all stacked mounts that our repeated installs may have created.
  while grep -F " $_target " /proc/mounts >/dev/null 2>&1; do
    umount "$_target" 2>/dev/null || break
  done
}

unmount_ours() {
  unmount_one "$DP_TARGET"
  unmount_one "$JS_TARGET"
  unmount_one "$TARGET"
}

case "$MODE" in
  install)
    # Never change the CCU's read-only file. Build our own derived copy on
    # /usr/local and bind-mount it over the generated DEVDB at runtime.
    unmount_ours
    [ -f "$TARGET" ] || exit 0

    TARGET="$TARGET" OVERLAY="$OVERLAY" /usr/bin/tclsh <<'TCL'
set src $::env(TARGET)
set dst $::env(OVERLAY)
source $src

set type "ModBus"
set path "/addons/ccu-modbus/img/modbus-logo.png"

if {[lsearch -exact $DEV_LIST $type] < 0} {
    lappend DEV_LIST $type
}
set DEV_DESCRIPTION($type) "ModBus"
set DEV_PATHS($type) [list [list 50 $path] [list 250 $path]]
set DEV_HIGHLIGHT($type) {}

set f [open $dst w]
puts $f "set DEV_LIST [list $DEV_LIST]"
puts $f "array set DEV_DESCRIPTION [list [array get DEV_DESCRIPTION]]"
puts $f "array set DEV_PATHS [list [array get DEV_PATHS]]"
puts $f "array set DEV_HIGHLIGHT [list [array get DEV_HIGHLIGHT]]"
close $f
TCL

    mount -o bind "$OVERLAY" "$TARGET"

    # The current OpenCCU WebUI loads the generated /www/devdescr.js directly.
    # DEVDB.tcl alone is therefore not enough for a device picture in the
    # native device list. Overlay a derived JS copy as well, without touching
    # the read-only original.
    if [ -f "$JS_TARGET" ]; then
      cp -f "$JS_TARGET" "$JS_OVERLAY"
      cat >>"$JS_OVERLAY" <<'JS'

// CCU-Modbus runtime device description
if (typeof DEV_LIST !== "undefined" && DEV_LIST.indexOf("ModBus") < 0) DEV_LIST.push("ModBus");
if (typeof DEV_DESCRIPTION !== "undefined") DEV_DESCRIPTION["ModBus"] = "ModBus";
if (typeof DEV_PATHS !== "undefined") {
  DEV_PATHS["ModBus"] = new Object();
  DEV_PATHS["ModBus"]["50"] = "/addons/ccu-modbus/img/modbus-logo.png";
  DEV_PATHS["ModBus"]["250"] = "/addons/ccu-modbus/img/modbus-logo.png";
}
if (typeof DEV_HIGHLIGHT !== "undefined") DEV_HIGHLIGHT["ModBus"] = new Object();
JS
      mount -o bind "$JS_OVERLAY" "$JS_TARGET"
    fi

    # OpenCCU has no native status renderer for DIGITAL_INPUT.STATE. Older
    # migrated channels may additionally retain DOOR_SENSOR.STATE metadata in
    # ReGa. Overlay the dispatcher and handle DIGITAL_INPUT explicitly before
    # the generic control-name dispatch runs. The original CCU file remains
    # untouched and is revealed again when the addon is removed.
    if [ -f "$DP_TARGET" ]; then
      TMP_DP="$DP_OVERLAY.tmp.$$"
      awk '
        { print }
        !inserted && /object ch = dom.GetObject\(chnId\);/ {
          inserted=1
          print "          if ((oDevice.HssType() == \"ModBus\") && (sControlName.Find(CN_DOOR_SENSOR) > -1)) {"
          print "            string ccuModbusDigitalInputState = \"LOW\";"
          print "            if (oE.Value() == true) { ccuModbusDigitalInputState = \"HIGH\"; }"
          print "            WriteLine(\"<td><div class=\x27ControlBtnInfo CLASS02532a\x27 style=\x27text-align:center; min-width:110px; height:35px; line-height:35px; font-weight:bold;\x27>\"#ccuModbusDigitalInputState#\"</div></td>\");"
          print "            isKnownControl = true;"
          print "            sLastControlName = \"CCU_MODBUS_DIGITAL_INPUT.\";"
          print "            sControlName = \"CCU_MODBUS_DIGITAL_INPUT.\";"
          print "          }"
        }
      ' "$DP_TARGET" > "$TMP_DP"
      [ -s "$TMP_DP" ] || { rm -f "$TMP_DP"; exit 1; }
      mv -f "$TMP_DP" "$DP_OVERLAY"
      mount -o bind "$DP_OVERLAY" "$DP_TARGET"
    fi
    ;;

  remove)
    # Removing the bind mount instantly exposes the untouched CCU file again.
    unmount_ours
    rm -rf "$BASE"
    ;;

  *)
    echo "Usage: $0 {install|remove}" >&2
    exit 2
    ;;
esac
