#!/bin/sh

ADDON=ccu-modbus
ADDONS_DIR=/usr/local/addons
BASE=$ADDONS_DIR/$ADDON
CONFROOT=/usr/local/etc/config
CONF=$CONFROOT/addons/$ADDON
WEBLINK=$CONFROOT/addons/www/$ADDON
RCD=$CONFROOT/rc.d
EXITCODE=10
NEW_INTERFACE=0
INTERFACES=/etc/config/InterfacesList.xml

mount | grep /usr/local >/dev/null 2>&1
if [ $? -eq 1 ]; then
  mount /usr/local
fi

mkdir -p "$ADDONS_DIR" "$CONFROOT/addons/www" "$RCD" "$CONF"

if [ -f "$RCD/$ADDON" ]; then
  EXITCODE=0
fi

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|amd64) SRC=bin/linux-amd64/ccu-modbusd ;;
  aarch64|arm64) SRC=bin/linux-arm64/ccu-modbusd ;;
  armv7l|armv6l|arm) SRC=bin/linux-arm/ccu-modbusd ;;
  *) echo "Unsupported architecture: $ARCH"; exit 13 ;;
esac
[ -f "$SRC" ] && [ -f "$(dirname "$SRC")/ccu-modbus-update" ] || { echo "Missing binary: $SRC" >&2; exit 13; }
# Validate everything needed before stopping the running addon.
for f in bin/update_addon bin/register_devtype VERSION rc.d/ccu-modbus examples/config.json; do
  [ -f "$f" ] || { echo "Missing package file: $f" >&2; exit 13; }
done
[ -d www ] && [ -d lib ] || { echo "Incomplete addon package" >&2; exit 13; }
if [ $EXITCODE -eq 0 ]; then
  "$RCD/$ADDON" stop >/dev/null 2>&1 || true
fi

mkdir -p "$BASE/bin" "$BASE/www" "$BASE/lib"
rm -rf "$BASE/bin"/* "$BASE/www"/* "$BASE/lib"/*

cp -f "$SRC" "$BASE/bin/ccu-modbusd"
cp -f "$(dirname "$SRC")/ccu-modbus-update" "$BASE/bin/ccu-modbus-update"
chmod 755 "$BASE/bin/ccu-modbus-update"
chmod 755 "$BASE/bin/ccu-modbusd"
cp -f bin/update_addon "$BASE/bin/update_addon"
chmod 755 "$BASE/bin/update_addon"
cp -f bin/register_devtype "$BASE/bin/register_devtype"
chmod 755 "$BASE/bin/register_devtype"
cp -f VERSION "$BASE/VERSION"

cp -f rc.d/ccu-modbus "$RCD/ccu-modbus"
chmod 755 "$RCD/ccu-modbus"

cp -af www/. "$BASE/www/"
cp -af lib/. "$BASE/lib/"
chmod 755 "$BASE/www/"*.cgi 2>/dev/null || true

rmdir "$WEBLINK" 2>/dev/null || true
ln -sfn "$BASE/www" "$WEBLINK"

"$BASE/bin/register_devtype" install >/dev/null 2>&1 || true

if [ ! -f "$CONF/config.json" ]; then
  cp -f examples/config.json "$CONF/config.json"
fi

# Register the interface once. First installs activate ReGa after the
# OpenCCU addon installer exits; upgrades must not restart ReGa.
if [ -f "$INTERFACES" ] && ! grep -q "<name>CCU-Modbus</name>" "$INTERFACES"; then
  TMP="$INTERFACES.ccu-modbus.$"
  awk '
    /<\/interfaces>/ {
      print "\t<ipc>"
      print "\t \t<name>CCU-Modbus</name>"
      print "\t \t<url>xmlrpc://127.0.0.1:18701/RPC3</url>"
      print "\t \t<info>CCU-Modbus</info>"
      print "\t</ipc>"
    }
    { print }
  ' "$INTERFACES" > "$TMP" && cat "$TMP" > "$INTERFACES"
  rm -f "$TMP"
  NEW_INTERFACE=1
fi

touch "$CONFROOT/hm_addons.cfg"
"$BASE/bin/update_addon" ccu-modbus /addons/ccu-modbus/index.cgi CCU-Modbus "Modbus TCP Interface" "Modbus TCP Interface" || exit 14

# Mark the installed version overview for regeneration. On upgrades we start
# the check below, on first installs the marker survives the required reboot
# and the rc.d init action performs the check after the daemon starts.
touch "$CONF/addon_updates_refresh.pending"

sync

# Start daemon on first installation and upgrade, without forced reboot.
if [ ! -f /etc/init.d/S00InstallAddon ]; then
  cd /
  "$RCD/$ADDON" start || exit 14
fi

# One-time ReGa activation on first installation only.  Do not restart
# ReGa from inside install_addon: allow OpenCCU to finish the installation.
if [ "$NEW_INTERFACE" -eq 1 ] && [ ! -f /etc/init.d/S00InstallAddon ]; then
  installer_pid="$PPID"
  (
    n=0
    while kill -0 "$installer_pid" 2>/dev/null && [ "$n" -lt 90 ]; do
      sleep 1
      n=$((n+1))
    done
    sleep 3
    if [ -f "$INTERFACES" ] && grep -q '<name>CCU-Modbus</name>' "$INTERFACES"; then
      /etc/init.d/S70ReGaHss restart >/usr/local/tmp/ccu-modbus-rega-activation.log 2>&1
    fi
  ) </dev/null >/dev/null 2>&1 &
fi

# Asynchronous: do not block OpenCCU's installer on network update checks.
# If interrupted, rc.d init will retry after the next reboot.
"$RCD/$ADDON" refresh-addon-versions

exit 0
